# Valores apenas para uso local. Não contêm segredos reais.
DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet?sslmode=disable
HTTP_ADDR=:8080
# Quando a API roda fora do Docker, o Keycloak do compose responde em localhost:8081.
OIDC_ISSUER=http://localhost:8081/realms/wallet
OIDC_JWKS_URL=http://localhost:8081/realms/wallet/protocol/openid-connect/certs
# Referências pendentes (REFUND/ROLLBACK antes da transação referenciada)
PENDING_MAX_ATTEMPTS=8
PENDING_BASE_DELAY_MS=2000
PENDING_MAX_DELAY_MS=300000
WORKER_INTERVAL_MS=1000
SHUTDOWN_GRACE_SECONDS=20

# Mensageria (SQS). Com LocalStack: SQS_ENDPOINT=http://localhost:4566 e credenciais de teste.
# MESSAGING_ENABLED=false desliga consumidor, publicador e provisionamento de filas.
MESSAGING_ENABLED=true
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
COMMANDS_QUEUE_NAME=wager-transactions.fifo
COMMANDS_DLQ_NAME=wager-transactions-dlq.fifo
EVENTS_QUEUE_NAME=wallet-events.fifo
EVENTS_DLQ_NAME=wallet-events-dlq.fifo
SQS_MAX_RECEIVE=5
SQS_VISIBILITY_SECONDS=60
CONSUMER_WORKERS=4
OUTBOX_INTERVAL_MS=500
OUTBOX_BATCH=20
